#!/bin/sh
# Autostart: point the sway config's second-screen power off at
# second-screen-idle (111-sway-init writes the config again at every boot).
c=/storage/.config/sway/config
[ -f "$c" ] || exit 0
sed -i -E "s#^exec_always swaymsg '\[app_id=\"emulationstation\"\]' focus output ([A-Za-z0-9-]+), output ([A-Za-z0-9-]+) power off\$#exec_always /storage/.config/mpv/second-screen-idle \2 \1#" "$c"
